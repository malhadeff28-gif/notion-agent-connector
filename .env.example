APP_URL=http://127.0.0.1:3100
PORT=3100
BIND_HOST=127.0.0.1
DATABASE_PATH=./data/connector.sqlite
# Run node src/init.js to generate .env and a persistent random key.
ENCRYPTION_KEY=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Comma-separated exact browser origins allowed to call the control API.
# ALLOWED_ORIGINS=http://127.0.0.1:3100
# Automatic search indexing. One service process with persistent storage.
AUTO_INDEX=true
SYNC_INTERVAL_SECONDS=300
MAX_INDEXED_DOCUMENTS=5000
# Per-pass cap for agent-mediated plugin discovery.
PLUGIN_INDEX_LIMIT=100
